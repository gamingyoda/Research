#include <stdio.h>
#include <math.h>
#include <stdlib.h>

/* No:0 */
#define ds 2.0e-5                /* 最小格子幅 */
#define XN 100                   /* xi方向格子数 */
#define YN 250                   /* eta方向格子数 */
#define RR 0.25                  /* 円の半径 */

/* No:1 */
#define XN1 250                   /* xi方向格子数  */
#define YN1 131                   /* eta方向格子数 */
#define jmax 65                   /* 内部境界との受け渡し定数 */
#define jmin 182                  /*          上同            */

/* No:2 */
#define XN2 70                    /* xi方向格子数 */
#define YN2 124                   /* eta方向格子数 */

#define NT 3                      /* 領域数 0:inner 1:wake 2:outer */

unsigned int i, j, r0, r1, r2, n;
unsigned int it[NT], jt[NT];
unsigned int Sj[NT],  Sij[NT],  S;
unsigned int isize = sizeof(int);
unsigned int dsize = sizeof(double);
unsigned int dG[NT], dE[NT];
double *x[NT], *y[NT];
double *cen_x[NT], *cen_y[NT];
double *x_xi[NT],  *y_xi[NT];                             /* ノードのメトリック */
double *x_eta[NT], *y_eta[NT];                            /* ノードのメトリック */
double *x_xi_cen[NT],  *y_xi_cen[NT];                     /* セル中心のメトリック */
double *x_eta_cen[NT], *y_eta_cen[NT];                    /* セル中心のメトリック */
double *Sur[NT];                                  /* セルの面積 */
double *d_wall[NT];                               /* 壁からの距離 */
double *deruta_x[NT], *deruta_y[NT];
double H_wall;

/*********** for Vinokur ************/
#define SS_left  0.0025                /* 左端の格子幅 */
#define SS_right 0.1                   /* 右端の格子幅 */
int N = 66;
double kyori;
double dd[1000];
static double calc_sin(double B);
static double calc_sinh(double B);
static void vinokur();


void read(void);
void grid(void);
void cen_grid(void);
void Metrics_calc(void);
void walldistance_calc(void);
void post(int nn);
void post_cen(int nn);
void write(void);


inline int dim(int i, int j, int SS){
  return i+(SS)*j;
}


