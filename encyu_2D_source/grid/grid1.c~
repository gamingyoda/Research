void grid(void){
  double p;
  double xi;
  double sita;
  double r, dr, rr;


  cen_grid();

  Metrics_calc();
  walldistance_calc();

  post(0);
  post(1);
  post(2);

  post_cen(0);
  post_cen(1);
  post_cen(2);

  write();
}

void cen_grid(void){
  double r, dr, rr, drr;
  double sita;

  dr = ds;

  r = RR;

  //inner格子座標を計算する
  for(i=1;i<it[0];i++){

    r += dr;

    for(j=0;j<jt[0];j++){
      r0 = dim(i, j, it[0]);
      r1 = dim(0, j, it[0]);
      sita  = atan2(y[0][r1],x[0][r1]);


      x[0][r0] = r * cos(sita);
      y[0][r0] = r * sin(sita);

    }

    if(i!=0 && i!=1 && i!=2){
      if(dr<0.010){
	dr = 1.1 * dr;
      }
    }

  }


  //セル中心の座標を計算する
  for(i=0;i<it[0]-1;i++){
    for(j=0;j<jt[0]-1;j++){
      r0 = dim(i, j, it[0]);
      
      cen_x[0][r0] = 0.25 * (x[0][r0] + x[0][r0+dG[0]] + x[0][r0+dE[0]] + x[0][r0+dG[0]+dE[0]]);
      cen_y[0][r0] = 0.25 * (y[0][r0] + y[0][r0+dG[0]] + y[0][r0+dE[0]] + y[0][r0+dG[0]+dE[0]]);
      
    }
  }


  //wakeの格子を出力する
  for(j=0;j<jt[0]-3-jmin;j++){
    r0 = dim(it[0]-5, jmin+j, it[0]);
    r1 = dim(0,       j, it[1]);

    cen_x[1][r1] = cen_x[0][r0];
    cen_y[1][r1] = cen_y[0][r0];


    r0 = dim(it[0]-4, jmin+j, it[0]);
    r1 = dim(1,       j, it[1]);

    cen_x[1][r1] = cen_x[0][r0];
    cen_y[1][r1] = cen_y[0][r0];



    r0 = dim(it[0]-3, jmin+j, it[0]);
    r1 = dim(2,       j, it[1]);

    cen_x[1][r1] = cen_x[0][r0];
    cen_y[1][r1] = cen_y[0][r0];


    r0 = dim(it[0]-2, jmin+j, it[0]);
    r1 = dim(3,       j, it[1]);

    cen_x[1][r1] = cen_x[0][r0];
    cen_y[1][r1] = cen_y[0][r0];


  }


  for(j=jt[0]-3-jmin;j<jt[1]-1;j++){
    r0 = dim(it[0]-5, j-jmax+2, it[0]);
    r1 = dim(0,       j, it[1]);

    cen_x[1][r1] = cen_x[0][r0];
    cen_y[1][r1] = cen_y[0][r0];


    r0 = dim(it[0]-4, j-jmax+2, it[0]);
    r1 = dim(1,       j, it[1]);

    cen_x[1][r1] = cen_x[0][r0];
    cen_y[1][r1] = cen_y[0][r0];


    r0 = dim(it[0]-3, j-jmax+2, it[0]);
    r1 = dim(2,       j, it[1]);

    cen_x[1][r1] = cen_x[0][r0];
    cen_y[1][r1] = cen_y[0][r0];

    r0 = dim(it[0]-2, j-jmax+2, it[0]);
    r1 = dim(3,       j, it[1]);

    cen_x[1][r1] = cen_x[0][r0];
    cen_y[1][r1] = cen_y[0][r0];
  }



  r0 = dim(3, 0, it[1]);
  r = sqrt(cen_x[1][r0] * cen_x[1][r0] + cen_y[1][r0] * cen_y[1][r0]);
  rr = r;
  drr = dr;

  for(i=4;i<it[1]-1;i++){

    r += dr;
    
    for(j=0;j<jt[1]-1;j++){
      r0 = dim(i, j, it[1]);
      r1 = dim(0, j, it[1]);
      sita  = atan2(cen_y[1][r1],cen_x[1][r1]);


      cen_x[1][r0] = r * cos(sita);
      cen_y[1][r0] = r * sin(sita);

    }

    if(i!=0 && i!=1 && i!=2){
      if(dr<0.02){
	dr = 1.1 * dr;
      }
    }

  }

  //wakeの格子を出力する
  for(j=0;j<jt[0]-3-jmin;j++){
    r0 = dim(it[0]-5, jmin+j, it[0]);
    r1 = dim(0,       j, it[1]);

    x[1][r1] = x[0][r0];
    y[1][r1] = y[0][r0];


    r0 = dim(it[0]-4, jmin+j, it[0]);
    r1 = dim(1,       j, it[1]);

    x[1][r1] = x[0][r0];
    y[1][r1] = y[0][r0];



    r0 = dim(it[0]-3, jmin+j, it[0]);
    r1 = dim(2,       j, it[1]);

    x[1][r1] = x[0][r0];
    y[1][r1] = y[0][r0];


    r0 = dim(it[0]-2, jmin+j, it[0]);
    r1 = dim(3,       j, it[1]);

    x[1][r1] = x[0][r0];
    y[1][r1] = y[0][r0];

    r0 = dim(it[0]-1, jmin+j, it[0]);
    r1 = dim(4,       j, it[1]);

    x[1][r1] = x[0][r0];
    y[1][r1] = y[0][r0];

  }


  for(j=jt[0]-3-jmin;j<jt[1];j++){
    r0 = dim(it[0]-5, j-jmax+2, it[0]);
    r1 = dim(0,       j, it[1]);

    x[1][r1] = x[0][r0];
    y[1][r1] = y[0][r0];


    r0 = dim(it[0]-4, j-jmax+2, it[0]);
    r1 = dim(1,       j, it[1]);

    x[1][r1] = x[0][r0];
    y[1][r1] = y[0][r0];


    r0 = dim(it[0]-3, j-jmax+2, it[0]);
    r1 = dim(2,       j, it[1]);

    x[1][r1] = x[0][r0];
    y[1][r1] = y[0][r0];

    r0 = dim(it[0]-2, j-jmax+2, it[0]);
    r1 = dim(3,       j, it[1]);

    x[1][r1] = x[0][r0];
    y[1][r1] = y[0][r0];

    r0 = dim(it[0]-1, j-jmax+2, it[0]);
    r1 = dim(4,       j, it[1]);

    x[1][r1] = x[0][r0];
    y[1][r1] = y[0][r0];
  }

  r0 = dim(4, 0, it[1]);
  r = sqrt(x[1][r0] * x[1][r0] + y[1][r0] * y[1][r0]);

  for(i=5;i<it[1];i++){

    if(i!=it[1]-1){
      r2 = dim(i-2, 0, it[1]);
      r1 = dim(i-1, 0, it[1]);
      r0 = dim(i, 0, it[1]);
      r += 0.5 * (sqrt(pow(cen_x[1][r1] - cen_x[1][r2], 2.0) + pow(cen_y[1][r1] - cen_y[1][r2], 2.0)) + sqrt(pow(cen_x[1][r0] - cen_x[1][r1], 2.0) + pow(cen_y[1][r0] - cen_y[1][r1], 2.0)));
    }
    else{
      r2 = dim(i-3, 0, it[1]);
      r1 = dim(i-2, 0, it[1]);
      r0 = dim(i-1, 0, it[1]);
      r += 0.5 * (sqrt(pow(cen_x[1][r1] - cen_x[1][r2], 2.0) + pow(cen_y[1][r1] - cen_y[1][r2], 2.0)) + sqrt(pow(cen_x[1][r0] - cen_x[1][r1], 2.0) + pow(cen_y[1][r0] - cen_y[1][r1], 2.0)));

    }
    
    for(j=0;j<jt[1];j++){
      r0 = dim(i, j, it[1]);
      r1 = dim(0, j, it[1]);
      sita  = atan2(y[1][r1],x[1][r1]);


      x[1][r0] = r * cos(sita);
      y[1][r0] = r * sin(sita);

    }

    if(i!=0 && i!=1 && i!=2){
      if(drr<0.02){
  	drr = 1.1 * drr;
      }
    }

  }


  /* for(i=0;i<it[1]-1;i++){ */
  /*   for(j=0;j<jt[1]-1;j++){ */
  /*     r0 = dim(i, j, it[1]); */
  /*     printf("%d %d %e %e\n",i,j,cen_x[1][r0],cen_y[1][r0]); */
  /*   } */
  /* } */

  r0 = dim(3, 67, it[1]);
  r1 = dim(it[1]-2, 67, it[1]);
  H_wall = sqrt(cen_x[1][r1] * cen_x[1][r1] + cen_y[1][r1] * cen_y[1][r1]) - sqrt(cen_x[1][r0] * cen_x[1][r0] + cen_y[1][r0] * cen_y[1][r0]);


  /* outerの領域作成 */
  for(j=0;j<jt[2]-1;j++){
    r0 = dim(it[0]-5, jmax-2+j, it[0]);
    r1 = dim(0,       j, it[2]);

    cen_x[2][r1] = cen_x[0][r0];
    cen_y[2][r1] = cen_y[0][r0];

    r0 = dim(it[0]-4, jmax-2+j, it[0]);
    r1 = dim(1,       j, it[2]);

    cen_x[2][r1] = cen_x[0][r0];
    cen_y[2][r1] = cen_y[0][r0];


    r0 = dim(it[0]-3, jmax-2+j, it[0]);
    r1 = dim(2,       j, it[2]);

    cen_x[2][r1] = cen_x[0][r0];
    cen_y[2][r1] = cen_y[0][r0];

    r0 = dim(it[0]-2, jmax-2+j, it[0]);
    r1 = dim(3,       j, it[2]);

    cen_x[2][r1] = cen_x[0][r0];
    cen_y[2][r1] = cen_y[0][r0];
  }

  vinokur();

  for(i=4;i<it[2]-1;i++){

    dr = H_wall * dd[i-3];

    for(j=0;j<jt[2]-1;j++){
      r0 = dim(i, j, it[2]);
      r1 = dim(0, j, it[2]);
      sita  = atan2(cen_y[2][r1],cen_x[2][r1]);


      cen_x[2][r0] = (rr + dr) * cos(sita);
      cen_y[2][r0] = (rr + dr) * sin(sita);    
    }
  }

  /* outerの領域作成 */
  for(j=0;j<jt[2];j++){
    r0 = dim(it[0]-5, jmax-2+j, it[0]);
    r1 = dim(0,       j, it[2]);

    x[2][r1] = x[0][r0];
    y[2][r1] = y[0][r0];

    r0 = dim(it[0]-4, jmax-2+j, it[0]);
    r1 = dim(1,       j, it[2]);

    x[2][r1] = x[0][r0];
    y[2][r1] = y[0][r0];


    r0 = dim(it[0]-3, jmax-2+j, it[0]);
    r1 = dim(2,       j, it[2]);

    x[2][r1] = x[0][r0];
    y[2][r1] = y[0][r0];

    r0 = dim(it[0]-2, jmax-2+j, it[0]);
    r1 = dim(3,       j, it[2]);

    x[2][r1] = x[0][r0];
    y[2][r1] = y[0][r0];
  }

  r0 = dim(3, 0, it[1]);
  r = sqrt(x[1][r0] * x[1][r0] + y[1][r0] * y[1][r0]);


  for(i=4;i<it[2];i++){

    if(i!=it[2]-1){
      r2 = dim(i-2, 0, it[2]);
      r1 = dim(i-1, 0, it[2]);
      r0 = dim(i, 0, it[2]);
      r += 0.5 * (sqrt(pow(cen_x[2][r1] - cen_x[2][r2], 2.0) + pow(cen_y[2][r1] - cen_y[2][r2], 2.0)) + sqrt(pow(cen_x[2][r0] - cen_x[2][r1], 2.0) + pow(cen_y[2][r0] - cen_y[2][r1], 2.0)));
    }
    else{
      r1 = dim(i-2, 0, it[2]);
      r0 = dim(i-1, 0, it[2]);
      r += sqrt(pow(cen_x[2][r0] - cen_x[2][r1], 2.0) + pow(cen_y[2][r0] - cen_y[2][r1], 2.0));

    }
    
    for(j=0;j<jt[2];j++){
      r0 = dim(i, j, it[2]);
      r1 = dim(0, j, it[2]);
      sita  = atan2(y[2][r1],x[2][r1]);


      x[2][r0] = r * cos(sita);
      y[2][r0] = r * sin(sita);

    }

  }


}

void Metrics_calc(void){
  int n;
  double Sw, Ss, Se, Sn;


  for(n=0;n<NT;n++){
    for(i=0;i<it[n]-1;i++){
      for(j=0;j<jt[n]-1;j++){
	r0 = dim(i, j, it[n]);
	if(i!=0 && i!=it[n]-2){
	  x_xi_cen[n][r0]  =  0.5 * (cen_x[n][r0+dG[n]] - cen_x[n][r0-dG[n]]);
	  y_xi_cen[n][r0]  = -0.5 * (cen_y[n][r0+dG[n]] - cen_y[n][r0-dG[n]]);
	}

	if(j!=0 && j!=jt[n]-2){
	  x_eta_cen[n][r0] = -0.5 * (cen_x[n][r0+dE[n]] - cen_x[n][r0-dE[n]]);
	  y_eta_cen[n][r0] =  0.5 * (cen_y[n][r0+dE[n]] - cen_y[n][r0-dE[n]]);
	}
      }
    }
  }

  for(n=0;n<NT;n++){
    for(i=1;i<it[n]-1;i++){
      for(j=1;j<jt[n]-1;j++){
	r0 = dim(i, j, it[n]);

	if(i!=it[n]-2 && j!=jt[n]-2){
	  x_xi[n][r0]  =  0.5 * (x_xi_cen[n][r0]  + x_xi_cen[n][r0-dE[n]]);
	  y_xi[n][r0]  =  0.5 * (y_xi_cen[n][r0]  + y_xi_cen[n][r0-dE[n]]);
	  x_eta[n][r0] =  0.5 * (x_eta_cen[n][r0] + x_eta_cen[n][r0-dG[n]]);
	  y_eta[n][r0] =  0.5 * (y_eta_cen[n][r0] + y_eta_cen[n][r0-dG[n]]);;
	}
	else{
	  x_xi[n][r0]  =   x[n][r0+dG[n]] - x[n][r0];
	  y_xi[n][r0]  = -(y[n][r0+dG[n]] - y[n][r0]);
	  x_eta[n][r0] = -(x[n][r0+dE[n]] - x[n][r0]);
	  y_eta[n][r0] =   y[n][r0+dE[n]] - y[n][r0];
	}

	deruta_x[n][r0] = sqrt((x[n][r0] - x[n][r0+dG[n]]) * (x[n][r0] - x[n][r0+dG[n]]) + (y[n][r0] - y[n][r0+dG[n]]) * (y[n][r0] - y[n][r0+dG[n]]));
	deruta_y[n][r0] = sqrt((x[n][r0] - x[n][r0+dE[n]]) * (x[n][r0] - x[n][r0+dE[n]]) + (y[n][r0] - y[n][r0+dE[n]]) * (y[n][r0] - y[n][r0+dE[n]]));

      }
    }
  }

  for(n=0;n<NT;n++){
    for(i=1;i<it[n]-1;i++){
      for(j=1;j<jt[n]-1;j++){
	r0 = dim(i, j, it[n]);

	if(i!=it[n]-2 && j!=jt[n]-2){
	  Sw = 0.5 * ((cen_x[n][r0] - cen_x[n][r0-dG[n]-dE[n]]) * (cen_y[n][r0-dG[n]] - cen_y[n][r0-dE[n]]) - (cen_y[n][r0] - cen_y[n][r0-dG[n]-dE[n]]) * (cen_x[n][r0-dG[n]] - cen_x[n][r0-dE[n]]));
	  Ss = 0.5 * ((cen_x[n][r0+dG[n]] - cen_x[n][r0-dE[n]]) * (cen_y[n][r0] - cen_y[n][r0+dG[n]-dE[n]]) - (cen_y[n][r0+dG[n]] - cen_y[n][r0-dE[n]]) * (cen_x[n][r0] - cen_x[n][r0+dG[n]-dE[n]]));
	  Se = 0.5 * ((cen_x[n][r0+dE[n]] - cen_x[n][r0-dG[n]]) * (cen_y[n][r0-dG[n]+dE[n]] - cen_y[n][r0]) - (cen_y[n][r0+dE[n]] - cen_y[n][r0-dG[n]]) * (cen_x[n][r0-dG[n]+dE[n]] - cen_x[n][r0]));
	  Sn = 0.5 * ((cen_x[n][r0+dG[n]+dE[n]] - cen_x[n][r0]) * (cen_y[n][r0+dE[n]] - cen_y[n][r0+dG[n]]) - (cen_y[n][r0+dG[n]+dE[n]] - cen_y[n][r0]) * (cen_x[n][r0+dE[n]] - cen_x[n][r0+dG[n]]));

	  Sur[n][r0] = 0.25 * (Sw + Ss + Se + Sn);
	}
	else{
	  Sur[n][r0] = x_xi[n][r0] * y_eta[n][r0] - y_xi[n][r0] * x_eta[n][r0];
	}
      }
    }
  }

}

void walldistance_calc(void){
  int n;
  int rw;

  //n=0
  for(i=2;i<it[0]-1;i++){
    for(j=0;j<jt[0]-1;j++){
      r0 = dim(i, j, it[0]);
      rw = dim(1, j, it[0]);

      d_wall[0][r0] = sqrt(pow(cen_x[0][r0] - cen_x[0][rw], 2.0) + pow(cen_y[0][r0] - cen_y[0][rw], 2.0));

      /* printf("n=0 %d %d %e\n",i,j,d_wall[0][r0]); */
    }
  }

  //n=1
  for(i=2;i<it[1]-1;i++){
    for(j=0;j<jt[0]-3-jmin;j++){
      rw = dim(1,  jmin+j, it[0]);
      r0 = dim(i,       j, it[1]);

      d_wall[1][r0] = sqrt(pow(cen_x[1][r0] - cen_x[0][rw], 2.0) + pow(cen_y[1][r0] - cen_y[0][rw], 2.0));
      /* printf("n=1 %d %d %e\n",i,j,d_wall[1][r0]); */
    }

    for(j=jt[0]-3-jmin;j<jt[1]-1;j++){
      rw = dim(1, j-jmax+2, it[0]);
      r0 = dim(i,        j, it[1]);

      d_wall[1][r0] = sqrt(pow(cen_x[1][r0] - cen_x[0][rw], 2.0) + pow(cen_y[1][r0] - cen_y[0][rw], 2.0));
      /* printf("n=1 %d %d %e\n",i,j,d_wall[1][r0]); */
    }
  }

  //n=2
  for(i=2;i<it[2]-1;i++){
    for(j=0;j<jt[2]-1;j++){
      rw = dim(1, jmax-2+j, it[0]);
      r0 = dim(i,        j, it[2]);

      d_wall[2][r0] = sqrt(pow(cen_x[2][r0] - cen_x[0][rw], 2.0) + pow(cen_y[2][r0] - cen_y[0][rw], 2.0));
      /* printf("n=2 %d %d %e\n",i,j,d_wall[2][r0]); */
    }
  }

}

/****************************************/
/*          メモリ確保関数              */
/****************************************/
void read(void){
  char fn[50];
  FILE *fpr;

  sprintf(fn,"hokan");

  fpr = fopen(fn, "r");
  if(NULL == fpr){
    perror(fn);
    exit(1);
  }


  it[0] = XN;
  jt[0] = YN;

  dG[0] = 1;
  dE[0] = it[0];

  it[1] = XN1;
  jt[1] = YN1;

  dG[1] = 1;
  dE[1] = it[1];

  it[2] = XN2;
  jt[2] = YN2;

  dG[2] = 1;
  dE[2] = it[2];


  /************ grid memory ****************/
  for(n=0;n<NT;n++){
    Sij[n]  = it[n] * jt[n];             
    S    = dsize * Sij[n];
    
    if( ( x[n] = (double*)malloc(S) ) == NULL ){ printf("No memories for 'x'\n"); exit(0);}
    if( ( y[n] = (double*)malloc(S) ) == NULL ){ printf("No memories for 'y'\n"); exit(0);}
    if( ( cen_x[n] = (double*)malloc(S) ) == NULL ){ printf("No memories for 'cen_x'\n"); exit(0);}
    if( ( cen_y[n] = (double*)malloc(S) ) == NULL ){ printf("No memories for 'cen_y'\n"); exit(0);}
    if( ( x_xi[n] = (double*)malloc(S) ) == NULL ){ printf("No memories for 'x'\n"); exit(0);}
    if( ( y_xi[n] = (double*)malloc(S) ) == NULL ){ printf("No memories for 'y'\n"); exit(0);}
    if( ( x_eta[n] = (double*)malloc(S) ) == NULL ){ printf("No memories for 'cen_x'\n"); exit(0);}
    if( ( y_eta[n] = (double*)malloc(S) ) == NULL ){ printf("No memories for 'cen_y'\n"); exit(0);}
    if( ( x_xi_cen[n] = (double*)malloc(S) ) == NULL ){ printf("No memories for 'x'\n"); exit(0);}
    if( ( y_xi_cen[n] = (double*)malloc(S) ) == NULL ){ printf("No memories for 'y'\n"); exit(0);}
    if( ( x_eta_cen[n] = (double*)malloc(S) ) == NULL ){ printf("No memories for 'cen_x'\n"); exit(0);}
    if( ( y_eta_cen[n] = (double*)malloc(S) ) == NULL ){ printf("No memories for 'cen_y'\n"); exit(0);}
    if( ( Sur[n] = (double*)malloc(S) ) == NULL ){ printf("No memories for 'cen_x'\n"); exit(0);}
    if( ( d_wall[n] = (double*)malloc(S) ) == NULL ){ printf("No memories for 'cen_y'\n"); exit(0);}
    if( ( deruta_x[n] = (double*)malloc(S) ) == NULL ){ printf("No memories for 'cen_y'\n"); exit(0);}
    if( ( deruta_y[n] = (double*)malloc(S) ) == NULL ){ printf("No memories for 'cen_y'\n"); exit(0);}

  }
  /************************ [ initail grid ] ****************************/
  /*              注: i と j の並び順は出力順に並べること               */
  /**********************************************************************/
  for(j=2;j<jt[0]-2;j++){
    r0 = dim(0, j, it[0]);
    fscanf(fpr,"%lf %lf",&x[0][r0], &y[0][r0]);
  }

  r0 = dim(0, 0, it[0]);
  r1 = dim(0, jt[0]-5, it[0]);
  x[0][r0] = x[0][r1];
  y[0][r0] = y[0][r1];

  r0 = dim(0, 1, it[0]);
  r1 = dim(0, jt[0]-4, it[0]);
  x[0][r0] = x[0][r1];
  y[0][r0] = y[0][r1];

  r0 = dim(0, jt[0]-2, it[0]);
  r1 = dim(0, 3, it[0]);
  x[0][r0] = x[0][r1];
  y[0][r0] = y[0][r1];

  r0 = dim(0, jt[0]-1, it[0]);
  r1 = dim(0, 4, it[0]);
  x[0][r0] = x[0][r1];
  y[0][r0] = y[0][r1];

  /* for(i=0;i<1;i++){ */
  /*   for(j=0;j<jt;j++){ */
  /*     r0 = dim(i, j); */
  /*     printf("%d %d %e %e\n",i,j,x[r0],y[r0]); */
  /*   } */
  /* } */


  printf("End of read()!\n");
}


/*----------------------------------------------------------*/
/*                  postkun用出力関数                       */
/*----------------------------------------------------------*/
void post_cen(int nn){
  char fn[50];
  FILE *fpw;
  unsigned int sizeG, num, r0;
  int xi, eta;
  double Nij;

  sprintf(fn, "postGrid[%d]",nn);

  fpw = fopen(fn,"wb");

  if(NULL==fpw){
    perror(fn);
    exit(1);
  }

  num = sizeof(int) * 2;
  xi  = it[nn]-1;
  eta = jt[nn]-1;

  fwrite(&num,sizeof(int),1,fpw);
  fwrite(&xi,sizeof(int),1,fpw);
  fwrite(&eta,sizeof(int),1,fpw);
  fwrite(&num,sizeof(int),1,fpw);

  num = sizeof(double) * 2 * xi * eta;
  Nij = xi * eta;

  fwrite(&num,sizeof(int),1,fpw);
  for(j=0;j<jt[nn]-1;j++){
    for(i=0;i<it[nn]-1;i++){
      r0 = dim(i, j, it[nn]);
      fwrite(&cen_x[nn][r0],sizeof(double),1,fpw);
    }
  }
  for(j=0;j<jt[nn]-1;j++){
    for(i=0;i<it[nn]-1;i++){
      r0 = dim(i, j, it[nn]);
      fwrite(&cen_y[nn][r0],sizeof(double),1,fpw);
    }
  }
  fwrite(&num,sizeof(int),1,fpw);

  fclose(fpw);

  printf(" End of 'post' \n");
}

/*----------------------------------------------------------*/
/*                  postkun用出力関数                       */
/*----------------------------------------------------------*/
void post(int nn){
  char fn[50];
  FILE *fpw;
  unsigned int sizeG, num, r0;
  int xi, eta;
  double Nij;

  sprintf(fn, "Raw_Grid[%d]",nn);

  fpw = fopen(fn,"wb");

  if(NULL==fpw){
    perror(fn);
    exit(1);
  }

  num = sizeof(int) * 2;
  xi  = it[nn];
  eta = jt[nn];

  fwrite(&num,sizeof(int),1,fpw);
  fwrite(&xi,sizeof(int),1,fpw);
  fwrite(&eta,sizeof(int),1,fpw);
  fwrite(&num,sizeof(int),1,fpw);

  num = sizeof(double) * 2 * xi * eta;

  fwrite(&num,sizeof(int),1,fpw);
  fwrite(x[nn],sizeof(double),Sij[nn],fpw);
  fwrite(y[nn],sizeof(double),Sij[nn],fpw);
  fwrite(&num,sizeof(int),1,fpw);

  fclose(fpw);

  printf(" End of 'post' \n");
}

/**************************************************************/
/*                  格子データ出力関数                        */
/* 格子数、セル中心座標、メトリックス、セル面積、壁からの距離 */
/**************************************************************/
void write(void){
  char fn[50];
  FILE *fpw;
  int n;

  sprintf(fn,"grid_data");

  fpw = fopen(fn, "w");
  if(NULL == fpw){
    perror(fn);
    exit(1);
  }

  for(n=0;n<NT;n++){
    fprintf(fpw,"%d %d\n",it[n], jt[n]);

    /*************** [ write cell-center grid data ] *******************/
    for(i=0;i<it[n]-1;i++){
      for(j=0;j<jt[n]-1;j++){
	r0 = dim(i, j, it[n]);      
	fprintf(fpw,"%e %e\n",cen_x[n][r0], cen_y[n][r0]);
      }
    }

    /*************** [ write metrics and area data ] *******************/
    for(i=0;i<it[n]-1;i++){
      for(j=0;j<jt[n]-1;j++){
	r0 = dim(i, j, it[n]);      
	fprintf(fpw,"%e %e %e %e %e\n",x_xi[n][r0], y_xi[n][r0], x_eta[n][r0], y_eta[n][r0], Sur[n][r0]);
      }
    }

    /*************** [ write metrics (cell-center) ] *******************/
    for(i=0;i<it[n]-1;i++){
      for(j=0;j<jt[n]-1;j++){
	r0 = dim(i, j, it[n]);      
	fprintf(fpw,"%e %e %e %e\n",x_xi_cen[n][r0], y_xi_cen[n][r0], x_eta_cen[n][r0], y_eta_cen[n][r0]);
      }
    }

    /*************** [ write distance data from wall ] *******************/
    for(i=0;i<it[n]-1;i++){
      for(j=0;j<jt[n]-1;j++){
	r0 = dim(i, j, it[n]);      
	fprintf(fpw,"%e\n",d_wall[n][r0]);
      }
    }

    /*************** [ write filter width data ] *******************/
    for(i=0;i<it[n]-1;i++){
      for(j=0;j<jt[n]-1;j++){
	r0 = dim(i, j, it[n]);      
	fprintf(fpw,"%e %e\n",deruta_x[n][r0], deruta_y[n][r0]);
      }
    }

  }


  fclose(fpw);  
  
  printf(" End of 'write(void)'  \n");  


}


/**********************************************/
/*  Two-Sided Stretching Function of Vinokur  */
/**********************************************/
static void vinokur(){
  unsigned int ii;
  double S0, S1, A, B, dz, xi, ui;

  S0 = 1.0 / ((N - 1.0) * SS_left);
  S1 = 1.0 / ((N - 1.0) * SS_right);
  A = sqrt(S0 / S1);
  B = sqrt(S0 * S1);

  if(B < 1.0){
    dz = calc_sin(B);
    for(ii=0;ii<N;ii++){
      xi = ((ii + 1.0) - 1.0) / (N - 1.0);               //(ii + 1.0)であるのに注意
      dd[ii] = tan(xi * dz) / (A * sin(dz) + (1.0 - A * cos(dz)) * tan(xi * dz));
    }
  }
  else if(B > 1.0){
    dz = calc_sinh(B);
    for(ii=0;ii<N;ii++){
      xi = ((ii + 1.0) - 1.0) / (N - 1.0);
      dd[ii] = tanh(xi * dz) / (A * sinh(dz) + (1.0 - A * cosh(dz)) * tanh(xi * dz));
    }
  }
  else{
    for(ii=0;ii<N;ii++){
      xi = ((ii + 1.0) - 1.0) / (N - 1.0);
      ui = xi * (1.0 + 2.0 * (B - 1.0) * (xi - 0.5) * (1.0 - xi));
      dd[ii] = ui / (A + (1.0 - A) * ui);
    }
  }
}


/**********************************************************/
/*          Inversion of y=sin(x)/x  from vinokur         */
/**********************************************************/
static double calc_sin(double B){
  double a3 =  -2.6449341;    double b2 =  0.057321429;
  double a4 =   6.7947320;    double b3 =  0.048774238;
  double a5 = -13.2055010;    double b4 = -0.053337753;
  double a6 =  11.7260950;    double b5 =  0.075845134;
  double result,    b;

  if(B < 0.26938972){
    result = M_PI * ((((((a6 * B + a5) * B + a4) * B + a3) * B + 1.0) * B - 1.0) * B + 1.0);
  }
  else{
    b = 1.0 - B;
    result = (sqrt(6.0 * b)) * (((((b5 * b + b4) * b + b3) * b + b2) * b + 0.15) * b + 1.0);
  }

  return result;
}

/**********************************************************/
/*         Inversion of y=sinh(x)/x  from vinokur         */
/**********************************************************/
static double calc_sinh(double B){
  double a2 =  0.057321429;     double a3 = -0.024907295;
  double a4 =  0.0077424461;    double a5 = -0.0010794123;
  double b0 = -0.02041793;      double b1 =  0.24902722;
  double b2 =  1.9496443;       double b3 = -2.6294547;
  double b4 =  8.56795911;
  double result, b, v, w;

  if(B < 2.7829681){
    b = B - 1.0;
    result = (sqrt(6.0 * b)) * (((((a5 * b + a4) * b + a3) * b + a2) * b - 0.15) * b +1.0);
  }
  else{
    v = log(B);
    w = 1.0 / B - 0.028527431;
    result = v + (log(2.0 * v)) * (1.0 + 1.0 / v) + (((b4 * w + b3) * w + b2) * w + b1) * w + b0;
  }

  return result;
}
